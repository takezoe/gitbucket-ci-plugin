<?xml version="1.0" encoding="UTF-8"?>
<changeSet>
    <addColumn tableName="CI_CONFIG">
        <column name="BUILD_FORK_PULL_REQUESTS" type="boolean" nullable="true"/>
    </addColumn>
    <update tableName="CI_CONFIG">
        <column name="BUILD_FORK_PULL_REQUESTS" valueBoolean="false"/>
    </update>
    <addNotNullConstraint tableName="CI_CONFIG" columnName="BUILD_FORK_PULL_REQUESTS" columnDataType="boolean"/>

    <addColumn tableName="CI_SYSTEM_CONFIG">
        <column name="BUILD_TIMEOUT_MINUTES" type="int" nullable="true"/>
    </addColumn>
    <update tableName="CI_SYSTEM_CONFIG">
        <column name="BUILD_TIMEOUT_MINUTES" valueNumeric="60"/>
    </update>
    <addNotNullConstraint tableName="CI_SYSTEM_CONFIG" columnName="BUILD_TIMEOUT_MINUTES" columnDataType="int"/>

    <addColumn tableName="CI_SYSTEM_CONFIG">
        <column name="MAX_KEPT_WORKSPACES" type="int" nullable="true"/>
    </addColumn>
    <!-- Keep every stored build's workspace, as before, until an admin lowers it -->
    <update tableName="CI_SYSTEM_CONFIG">
        <column name="MAX_KEPT_WORKSPACES" valueComputed="MAX_BUILD_HISTORY"/>
    </update>
    <addNotNullConstraint tableName="CI_SYSTEM_CONFIG" columnName="MAX_KEPT_WORKSPACES" columnDataType="int"/>
</changeSet>
